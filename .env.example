# Copy this file to ".env" and fill in what you need. All settings are optional.
# Never commit the real .env file (it's in .gitignore).

# Real AI. Get a key at https://console.anthropic.com -> API Keys.
# Without it, BugLens runs in demo mode (keyword rules).
ANTHROPIC_API_KEY=your-key-here

# Team dashboard password. Without it, the public demo password "demo123" is used.
TEAM_PASSWORD=choose-a-team-password

# Key for signing logins. Without it, everyone is logged out when the server restarts.
# Make one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=a-long-random-string
